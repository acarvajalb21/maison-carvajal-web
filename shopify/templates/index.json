    "mc_colecciones": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mc-section-head\">\n  <p class=\"mc-eyebrow\">Colecciones</p>\n  <h2>Explora el catálogo</h2>\n  <span class=\"mc-rule\" aria-hidden=\"true\"></span>\n</div>\n<div class=\"mc-collections\">\n  {%- assign tiles = 'nicho:creed-aventus,disenador:dior-sauvage-elixir,arabes:lattafa-khamrah' | split: ',' -%}\n  {%- for t in tiles -%}\n    {%- assign parts = t | split: ':' -%}\n    {%- assign c = collections[parts[0]] -%}\n    {%- assign img = all_products[parts[1]].featured_image -%}\n    <a class=\"mc-collection-tile{% if img %} mc-collection-tile--photo{% endif %}\" href=\"{{ c.url }}\">\n      {%- if img -%}\n        {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}\n      {%- endif -%}\n      <span class=\"mc-collection-tile__label\">\n        <span class=\"mc-collection-tile__name\">{{ c.title }}</span>\n        <span class=\"mc-collection-tile__cta\" aria-hidden=\"true\">Ver</span>\n      </span>\n    </a>\n  {%- endfor -%}\n</div>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "mc_casas": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mc-section-head\">\n  <p class=\"mc-eyebrow\">Casas</p>\n  <h2>Busca por marca</h2>\n  <span class=\"mc-rule\" aria-hidden=\"true\"></span>\n</div>\n<div class=\"mc-houses\">\n  {%- assign hs = 'nicho,disenador,arabes' | split: ',' -%}\n  {%- for h in hs -%}\n    {%- assign c = collections[h] -%}\n    {%- comment -%} Solo marcas con al menos un perfume publicado, disponible y con precio (las colecciones tienen menos de 50 productos). {%- endcomment -%}\n    {%- assign vlist = '' -%}\n    {%- for p in c.products -%}\n      {%- if p.available and p.price > 0 -%}\n        {%- assign key = '|' | append: p.vendor | append: '|' -%}\n        {%- unless vlist contains key -%}\n          {%- assign vlist = vlist | append: key -%}\n        {%- endunless -%}\n      {%- endif -%}\n    {%- endfor -%}\n    {%- assign vendors = vlist | split: '|' | sort_natural -%}\n    <div>\n      <h3>{{ c.title }}</h3>\n      <ul>\n        {%- for v in vendors -%}\n          {%- if v != blank -%}\n            <li><a href=\"{{ v | url_for_vendor }}\">{{ v }}</a></li>\n          {%- endif -%}\n        {%- endfor -%}\n      </ul>\n    </div>\n  {%- endfor -%}\n</div>",
        "background_color": "#F4F0E8",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
    "mc_asesoria": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mc-advice\">\n  <div>\n    <p class=\"mc-eyebrow\">Atención personalizada</p>\n    <h2>¿No sabes cuál elegir?</h2>\n    <p>Cuéntanos si el perfume es para ti o para regalo, qué aromas te gustan y para qué ocasión. Te recomendamos opciones según tu gusto y presupuesto.</p>\n    {% render 'mc-whatsapp', class: 'mc-btn--dark', label: 'Escríbenos por WhatsApp' %}\n  </div>\n  <ol class=\"mc-steps\">\n    <li><div><strong>Escríbenos</strong><span>Por WhatsApp o Instagram @maisoncarvajal.</span></div></li>\n    <li><div><strong>Cuéntanos qué buscas</strong><span>Aromas que te gustan, los que evitas, ocasión y presupuesto.</span></div></li>\n    <li><div><strong>Recibe tu perfume</strong><span>Confirmamos precio y disponibilidad. Entrega de 2 a 5 días hábiles.</span></div></li>\n  </ol>\n</div>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 56,
        "padding-block-end": 56
      }
    },
