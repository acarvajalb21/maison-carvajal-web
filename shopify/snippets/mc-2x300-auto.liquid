<script type="module">
  if (!window.mc2x300) {
    window.mc2x300 = {};
    const raiz = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    const datos = JSON.parse(document.getElementById('mc-2x300-reglas').textContent);
    const PREFIJO = 'DEMO-';
    const MAX_CODIGOS = 5;
    const MAX_EXACTO = 14;
    const MAX_INTENTOS = 6;
    const PRECIOS = [30000000, 35000000, 40000000];
    const indice = new Map(datos.v.map((id, i) => [id, i]));
    const clave = (i, j) => Math.min(i, j) + '-' + Math.max(i, j);
    const pareja = new Map(datos.p.map(([i, j, monto], n) => [
      clave(i, j),
      { k: clave(i, j), monto: monto * 100, codigo: PREFIJO + String(n + 1).padStart(3, '0') }
    ]));
    const grupos = datos.g.map(([n, xs, ys]) => ({
      codigo: PREFIJO + String(n).padStart(2, '0'),
      claves: new Set(xs.flatMap((x) => ys.map((y) => clave(x, y))))
    }));
    const esPropio = (c) => c.toUpperCase().startsWith(PREFIJO);
    const mismas = (a, b) => a.length === b.length && a.every((c) => b.includes(c));
    const ahorro = (c) => c.original_total_price - c.total_price;

    // Pareja válida hoy: si un precio cambió y la resta ya no da un precio de la promoción, no se usa.
    let vetadas = [];
    const valida = (a, b) => {
      const p = pareja.get(clave(a.i, b.i));
      return p && !vetadas.includes(p.codigo) && PRECIOS.includes(a.precio + b.precio - p.monto) ? p : null;
    };

    // Emparejamiento exacto de mayor ahorro para pocas unidades.
    const exacto = (u) => {
      const memo = new Map();
      const mejor = (libres) => {
        if (!libres) return { total: 0, usadas: [] };
        if (memo.has(libres)) return memo.get(libres);
        const i = 31 - Math.clz32(libres & -libres);
        const resto = libres & ~(1 << i);
        let res = mejor(resto);
        for (let j = i + 1; j < u.length; j++) {
          if (!(resto & (1 << j))) continue;
          const p = valida(u[i], u[j]);
          if (!p) continue;
          const sub = mejor(resto & ~(1 << j));
          if (sub.total + p.monto > res.total) res = { total: sub.total + p.monto, usadas: [{ p, u: [u[i], u[j]] }, ...sub.usadas] };
        }
        memo.set(libres, res);
        return res;
      };
      return mejor(2 ** u.length - 1);
    };

    // Carritos grandes: se arranca por mayor ahorro y se mejora de a dos grupos hasta que no haya ganancia.
    const emparejar = (u) => {
      if (u.length <= MAX_EXACTO) return exacto(u).usadas;
      let partes = u.map((x) => ({ total: 0, u: [x], usadas: [] }));
      for (let v = 0; v < 60; v++) {
        let top = null;
        for (let a = 0; a < partes.length; a++) {
          for (let b = a + 1; b < partes.length; b++) {
            const un = [...partes[a].u, ...partes[b].u];
            const r = exacto(un);
            const gana = r.total - partes[a].total - partes[b].total;
            if (gana > 0 && (!top || gana > top.gana)) top = { a, b, r, un, gana };
          }
        }
        if (!top) break;
        const en = new Set(top.r.usadas.flatMap((x) => x.u));
        partes = partes.filter((_, n) => n !== top.a && n !== top.b);
        for (const x of top.r.usadas) partes.push({ total: x.p.monto, u: x.u, usadas: [x] });
        for (const x of top.un) if (!en.has(x)) partes.push({ total: 0, u: [x], usadas: [] });
      }
      return partes.flatMap((x) => x.usadas);
    };

    // Devuelve el mayor ahorro posible y las listas de códigos que conviene probar, en orden.
    const planear = (cart, ajenos, sin = []) => {
      vetadas = sin;
      const u = [];
      for (const it of cart.items) {
        const i = indice.get(it.variant_id);
        if (i !== undefined) for (let n = 0; n < it.quantity && u.length < 40; n++) u.push({ i, precio: it.original_price });
      }
      const cupo = Math.max(0, MAX_CODIGOS - ajenos.length);
      const usadas = u.length > 1 ? emparejar(u).map((x) => x.p) : [];
      const esperado = usadas.reduce((s, p) => s + p.monto, 0);
      const porCodigo = new Map();
      for (const p of usadas) porCodigo.set(p.codigo, (porCodigo.get(p.codigo) || 0) + p.monto);
      const sueltos = [...porCodigo].sort((a, b) => b[1] - a[1]).map(([c]) => c);
      const veces = new Map([...porCodigo].map(([c, total]) => [c, total / usadas.find((p) => p.codigo === c).monto]));
      if (sueltos.length <= cupo) return { esperado, veces, opciones: [sueltos] };
      let faltan = [...usadas];
      const elegidos = [];
      while (faltan.length && elegidos.length < cupo) {
        let top = { gana: 0 };
        for (const g of grupos) {
          const cubre = faltan.filter((p) => g.claves.has(p.k));
          const gana = cubre.reduce((s, p) => s + p.monto, 0);
          if (gana > top.gana) top = { gana, cubre, codigo: cubre.every((p) => p.k === cubre[0].k) ? cubre[0].codigo : g.codigo };
        }
        if (!top.codigo) break;
        elegidos.push(top.codigo);
        faltan = faltan.filter((p) => !top.cubre.includes(p));
      }
      return { esperado, veces, opciones: [elegidos, sueltos.slice(0, cupo)] };
    };

    // Con perfumes repetidos, Shopify puede usar un código más veces de lo planeado y dejar otra pareja sin perfume.
    // Propone planes alternos: sin los códigos que no entraron y sin los que se usaron de más.
    const alternos = (c, ajenos, plan) => {
      const dado = new Map();
      for (const it of c.items) {
        for (const d of it.line_level_discount_allocations || []) {
          const t = d.discount_application.title;
          dado.set(t, (dado.get(t) || 0) + d.amount);
        }
      }
      const fuera = (c.discount_codes || []).filter((d) => esPropio(d.code) && !d.applicable).map((d) => d.code);
      const demas = [...plan.veces].filter(([k, n]) => {
        const p = [...pareja.values()].find((x) => x.codigo === k);
        return (dado.get(k) || 0) > p.monto * n;
      }).map(([k]) => k);
      return [fuera, demas, ...fuera.map((k) => [k])].filter((l) => l.length).map((l) => planear(c, ajenos, l));
    };

    const leer = async () => (await fetch(raiz + 'cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' })).json();
    const poner = async (codigos) => {
      const r = await fetch(raiz + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ discount: codigos.join(',') })
      });
      if (!r.ok) throw new Error('cart/update ' + r.status);
      return r.json();
    };

    const avisar = async (cart) => {
      try {
        const { CartDiscountUpdateEvent: E } = await import('@shopify/events');
        const d = E.createPromise();
        const ev = new E({ discountCodes: (cart.discount_codes || []).map(({ code }) => ({ code })), promise: d.promise });
        ev.mc2x300 = true;
        document.dispatchEvent(ev);
        d.resolve({ cart: E.createCartFromAjaxResponse(cart) });
      } catch (e) {
        if (document.querySelector('cart-items-component')) location.reload();
      }
    };

    let ultima = null;
    const revisar = async () => {
      const cart = await leer();
      const actuales = (cart.discount_codes || []).map((d) => d.code);
      const ajenos = actuales.filter((c) => !esPropio(c));
      const propios = actuales.filter(esPropio);
      const firma = JSON.stringify([ajenos, cart.items.map((i) => [i.variant_id, i.quantity, i.original_price])]);
      if (ultima && ultima.firma === firma && mismas(propios, ultima.propios)) return;
      const plan = planear(cart, ajenos);
      const { esperado, opciones } = plan;
      const sobran = (cart.discount_codes || []).some((d) => esPropio(d.code) && !d.applicable);
      const listo = ajenos.length ? mismas(opciones[0], propios) : ahorro(cart) >= esperado;
      let final = propios;
      if (sobran || !listo) {
        let mejor = null;
        let puestos = propios;
        const vistos = new Set();
        const cola = opciones.map((codigos) => ({ codigos, plan }));
        while (cola.length && vistos.size < MAX_INTENTOS) {
          const { codigos, plan: pl } = cola.shift();
          const id = [...codigos].sort().join();
          if (vistos.has(id)) continue;
          vistos.add(id);
          const c = await poner([...ajenos, ...codigos]);
          puestos = codigos;
          if (!mejor || c.total_price < mejor.c.total_price) mejor = { c, codigos };
          if (ajenos.length || ahorro(c) >= esperado) break;
          for (const alt of alternos(c, ajenos, pl)) cola.push({ codigos: alt.opciones[0], plan: alt });
        }
        // Los códigos que Shopify no usó se quitan: al cliente le conviene más lo que ya quedó aplicado.
        final = (mejor.c.discount_codes || []).filter((d) => esPropio(d.code) && d.applicable).map((d) => d.code);
        if (!mismas(final, puestos)) mejor.c = await poner([...ajenos, ...final]);
        await avisar(mejor.c);
      }
      ultima = { firma, propios: final };
    };

    // Una revisión a la vez; si el carrito cambia mientras tanto, se revisa otra vez al terminar.
    let enCurso = null;
    let pendiente = false;
    const pedir = () => {
      pendiente = true;
      if (!enCurso) {
        enCurso = (async () => {
          let vueltas = 0;
          while (pendiente && vueltas++ < 5) {
            pendiente = false;
            try { await revisar(); } catch (e) { console.warn('[2x300]', e); }
          }
        })().finally(() => { enCurso = null; });
      }
      return enCurso;
    };
    window.mc2x300.revisar = pedir;

    const alCambiar = (ev) => {
      if (ev.mc2x300) return;
      Promise.resolve(ev.promise).then(pedir, () => {});
    };
    document.addEventListener('shopify:cart:lines-update', alCambiar);
    document.addEventListener('shopify:cart:discount-update', alCambiar);
    window.addEventListener('pageshow', (ev) => {
      if (ev.persisted) { ultima = null; pedir(); }
    });
    {% if cart.item_count > 1 %}pedir();{% endif %}

    // Si el cliente pulsa "Pagar" mientras se revisa el carrito, se espera a que termine (máximo 4 s).
    document.addEventListener('click', (ev) => {
      const b = enCurso && ev.target.closest && ev.target.closest('[name="checkout"], a[href*="/checkout"]');
      if (!b) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      Promise.race([enCurso, new Promise((r) => setTimeout(r, 4000))]).then(() => { location.href = raiz + 'checkout'; });
    }, true);
  }
</script>
