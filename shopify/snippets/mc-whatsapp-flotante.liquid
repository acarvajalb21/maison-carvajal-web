{%- doc -%}
  MAISON CARVAJAL - botón fijo de WhatsApp para celular.
  Se carga desde snippets/mc-styles.liquid, así que aparece en todas las páginas.
  En la ficha de un perfume, el mensaje ya lleva el nombre de ese perfume.

  @param {boolean} [desktop] - true para mostrarlo también en computador
{%- enddoc -%}
{%- liquid
  assign wa_number = '57XXXXXXXXXX'
  if template.name == 'product' and product != blank
    assign wa_msg = 'Hola, me interesa ' | append: product.vendor | append: ' ' | append: product.title | append: '. ¿Me confirmas precio y disponibilidad? ' | append: shop.url | append: product.url
  else
    assign wa_msg = 'Hola, quiero asesoría para elegir un perfume.'
  endif
-%}
{%- if template.name == 'product' and product != blank -%}
  {%- capture mc_modo -%}{% render 'mc-modo-venta', product: product %}{%- endcapture -%}
  {%- if mc_modo contains 'pedido' -%}
    {%- capture wa_msg -%}{% render 'mc-pedido-msg', product: product %}{%- endcapture -%}
    {%- assign wa_msg = wa_msg | strip -%}
  {%- endif -%}
{%- endif -%}
<a
  class="mc-wa-float{% if desktop %} mc-wa-float--desktop{% endif %}{% if template.name == 'product' %} mc-wa-float--raised{% endif %}"
  href="https://wa.me/{{ wa_number }}?text={{ wa_msg | url_encode }}"
  target="_blank"
  rel="noopener"
  aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.25 8.25-8.25ZM8.53 7.33c-.16 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.29-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43h-.45Z"/>
  </svg>
</a>
<style>
  /* Los contenedores del tema no deben recortar ni reubicar el botón fijo. */
  .shopify-section:has(.mc-wa-float), .section:has(> .mc-wa-float), .section:has(> * > .mc-wa-float) { content-visibility: visible !important; contain: none !important; transform: none !important; filter: none !important; }
  .mc-wa-float { position: fixed; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 20; display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: #151515; color: #fff; border: 1px solid #c6a66b; text-decoration: none; box-shadow: 0 8px 24px rgba(21, 21, 21, 0.28); transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s ease; }
  .mc-wa-float:hover { transform: translateY(-2px); color: #fff; }
  .mc-wa-float:focus-visible { outline: 2px solid #c6a66b; outline-offset: 3px; }
  /* En la ficha de producto se sube para no tapar la barra fija de compra del tema. */
  .mc-wa-float--raised { bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 750px) {
    .mc-wa-float:not(.mc-wa-float--desktop) { display: none; }
    .mc-wa-float--desktop { right: 24px; bottom: 24px; }
  }
  /* Se oculta mientras hay un menú, carrito o ventana abierta encima. */
  body:has(dialog[open]) .mc-wa-float,
  body:has(details[id^='Details-menu-drawer'][open]) .mc-wa-float { opacity: 0; visibility: hidden; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .mc-wa-float { transition: none; }
    .mc-wa-float:hover { transform: none; }
  }
</style>
