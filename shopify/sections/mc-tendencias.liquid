{%- comment -%}
  MAISON CARVAJAL - "Lo que más está llamando la atención".
  Pestañas por tendencia (bloques editables): cada una con dato, explicación y perfumes reales
  del catálogo. Teclado: flechas, Inicio y Fin. Fuente visible al pie: no son cifras de ventas.
{%- endcomment -%}

<div class="section-background"></div>
<div
  class="section section--page-width spacing-style mc-trends"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="mc-section-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="mc-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 id="mc-trends-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    <span class="mc-rule" aria-hidden="true"></span>
    {%- if section.settings.intro != blank -%}
      <p>{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <mc-tabs class="mc-trends__tabs">
    <div class="mc-tablist" role="tablist" aria-labelledby="mc-trends-title-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          role="tab"
          class="mc-tab"
          id="mc-tab-{{ block.id }}"
          aria-controls="mc-panel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {% unless forloop.first %}
            tabindex="-1"
          {% endunless %}
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <span class="mc-tab__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="mc-tab__title">{{ block.settings.title }}</span>
          {%- if block.settings.stat != blank -%}
            <span class="mc-tab__stat">{{ block.settings.stat }}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="mc-panel"
        role="tabpanel"
        id="mc-panel-{{ block.id }}"
        aria-labelledby="mc-tab-{{ block.id }}"
        tabindex="0"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        {%- if block.settings.text != blank -%}
          <p class="mc-panel__text">{{ block.settings.text }}</p>
        {%- endif -%}
        <div class="mc-rail">
          {%- for p in block.settings.products -%}
            {% render 'mc-card', product: p %}
          {%- endfor -%}
          {%- if block.settings.collection != blank -%}
            <a class="mc-tcard mc-tcard--more" href="{{ block.settings.collection.url }}">
              <span class="mc-tcard__more-label">Ver toda la colección</span>
              <span class="mc-card-name">{{ block.settings.collection.title }}</span>
              <span class="mc-tcard__arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </mc-tabs>

  {%- if section.settings.source_note != blank -%}
    <p class="mc-source">{{ section.settings.source_note }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .mc-tablist { display: flex; gap: 0.5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.25rem 0.25rem 0.75rem; margin: 0 -0.25rem 1.5rem; scrollbar-width: none; }
  .mc-tablist::-webkit-scrollbar { display: none; }
  @media (min-width: 990px) { .mc-tablist { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); overflow: visible; } }
  .mc-tab { flex: 0 0 auto; scroll-snap-align: start; display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'num title' 'num stat'; column-gap: 0.75rem; row-gap: 0.15rem; align-items: center; min-width: 210px; padding: 1rem 1.15rem; text-align: left; background: #fff; color: #151515; border: 1px solid #e5ded0; border-radius: 10px; cursor: pointer; font: inherit; transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease; }
  /* Sin subtítulo: una sola fila para que el título quede a la altura del número. */
  .mc-tab:not(:has(.mc-tab__stat)) { grid-template-areas: 'num title'; grid-template-rows: auto; row-gap: 0; }
  .mc-tab__num, .mc-tab__title { line-height: 1.2; }
  .mc-tab:hover { border-color: #151515; transform: translateY(-2px); }
  .mc-tab:focus-visible { outline: 2px solid #c6a66b; outline-offset: 3px; }
  .mc-tab[aria-selected='true'] { background: #151515; color: #fff; border-color: #151515; }
  .mc-tab__num { grid-area: num; font-family: var(--font-heading--family); font-size: 1.5rem; color: #c6a66b; }
  .mc-tab__title { grid-area: title; font-family: var(--font-heading--family); font-size: 1.0625rem; line-height: 1.2; }
  .mc-tab__stat { grid-area: stat; font-size: 0.75rem; letter-spacing: 0.04em; color: #66615a; }
  .mc-tab[aria-selected='true'] .mc-tab__stat { color: rgba(255, 255, 255, 0.75); }
  /* Todas las pestañas ocupan la misma celda: la sección mide lo que la pestaña más alta
     y la página no salta al cambiar de una a otra. */
  .mc-trends__tabs { display: grid; grid-template-columns: minmax(0, 1fr); }
  .mc-trends__tabs > .mc-tablist { grid-row: 1; grid-column: 1; }
  .mc-trends__tabs > .mc-panel { grid-row: 2; grid-column: 1; min-width: 0; }
  .mc-trends__tabs > .mc-panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .mc-panel.is-entering { animation: mc-panel-in 0.45s ease both; }
  .mc-panel:focus-visible { outline: 2px solid #c6a66b; outline-offset: 6px; }
  @keyframes mc-panel-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .mc-panel__text { max-width: none; margin: 0 0 1.5rem; font-size: 1rem; line-height: 1.65; color: #66615a; }

  .mc-rail { display: grid; grid-auto-flow: column; grid-auto-columns: 62%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.75rem; scrollbar-width: thin; }
  @media (min-width: 750px) { .mc-rail { grid-auto-columns: 30%; } }
  @media (min-width: 990px) { .mc-rail { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; } }
  .mc-tcard { scroll-snap-align: start; display: flex; flex-direction: column; gap: 0.75rem; color: #151515; text-decoration: none; }
  .mc-tcard__media { position: relative; display: block; aspect-ratio: 1; background: #fff; border: 1px solid #efe9dc; border-radius: 10px; overflow: hidden; }
  .mc-tcard__media img { width: 100%; height: 100%; object-fit: contain; padding: 6%; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .mc-tcard__link:hover .mc-tcard__media img { transform: scale(1.06) rotate(-1.5deg); }
  .mc-tcard__link { display: flex; flex-direction: column; gap: 0.75rem; flex: 1 1 auto; color: inherit; text-decoration: none; }
  .mc-tcard__link:focus-visible, a.mc-tcard:focus-visible { outline: 2px solid #c6a66b; outline-offset: 4px; border-radius: 10px; }
  .mc-tcard__form { margin: 0; }
  .mc-tcard__add { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; padding: 0.55rem 0.75rem; background: transparent; color: #151515; border: 1px solid #151515; border-radius: 6px; font-family: var(--font-body--family); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; line-height: 1.2; text-align: center; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .mc-tcard__add:hover { background: #151515; color: #fff; }
  .mc-tcard__add:focus-visible { outline: 2px solid #c6a66b; outline-offset: 3px; }
  .mc-tcard__add[disabled] { cursor: progress; opacity: 0.6; }
  .mc-tcard__add[data-state='added'] { background: #151515; color: #fff; border-color: #151515; opacity: 1; }
  .mc-tcard__add[data-state='error'] { border-color: #a33a2b; color: #a33a2b; background: transparent; opacity: 1; }
  .mc-tcard__add--ask { border-color: #e5ded0; }
  .mc-tcard__body { display: flex; flex-direction: column; gap: 0.15rem; }
  .mc-tcard__price { margin-top: 0.25rem; font-size: 0.9375rem; font-weight: 600; }
  .mc-tcard--more { justify-content: center; align-items: flex-start; gap: 0.35rem; aspect-ratio: 1; padding: 1.5rem; background: #f4f0e8; border-radius: 10px; border: 1px solid #e5ded0; transition: background-color 0.25s ease, color 0.25s ease; }
  .mc-tcard--more:hover { background: #151515; color: #fff; }
  .mc-tcard__more-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #66615a; }
  .mc-tcard--more:hover .mc-tcard__more-label { color: #c6a66b; }
  .mc-tcard__arrow { font-size: 1.5rem; transition: transform 0.25s ease; }
  .mc-tcard--more:hover .mc-tcard__arrow { transform: translateX(6px); }
  @media (min-width: 990px) { .mc-tcard--more { aspect-ratio: auto; } }
  .mc-source { margin: 1.75rem auto 0; max-width: 46rem; text-align: center; font-size: 0.8125rem; line-height: 1.6; color: #66615a; }
  @media (prefers-reduced-motion: reduce) {
    .mc-panel.is-entering { animation: none; }
    .mc-tab, .mc-tcard__media img, .mc-tcard__arrow, .mc-tcard__add { transition: none; }
    .mc-tab:hover { transform: none; }
    .mc-tcard__link:hover .mc-tcard__media img { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('mc-tabs')) {
    customElements.define(
      'mc-tabs',
      class extends HTMLElement {
        connectedCallback() {
          this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
          this.tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => this.select(i));
            tab.addEventListener('keydown', (e) => {
              const last = this.tabs.length - 1;
              let next = null;
              if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
              if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
              if (e.key === 'Home') next = 0;
              if (e.key === 'End') next = last;
              if (next !== null) {
                e.preventDefault();
                this.select(next, true);
              }
            });
          });
          this.onBlockSelect = (e) => {
            const i = this.tabs.findIndex((t) => t.dataset.blockId === e.detail.blockId);
            if (i > -1) this.select(i);
          };
          document.addEventListener('shopify:block:select', this.onBlockSelect);
        }
        disconnectedCallback() {
          document.removeEventListener('shopify:block:select', this.onBlockSelect);
        }
        select(index, focus) {
          this.tabs.forEach((tab, i) => {
            const on = i === index;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            const panel = this.querySelector('#' + tab.getAttribute('aria-controls'));
            if (!panel) return;
            const wasHidden = panel.hidden;
            panel.hidden = !on;
            panel.classList.remove('is-entering');
            if (on && wasHidden) {
              void panel.offsetWidth;
              panel.classList.add('is-entering');
            }
          });
          const tab = this.tabs[index];
          if (focus) tab.focus();
          tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
        }
      }
    );
  }

  // "Agregar al carrito" de las tarjetas MC (tendencias y test), sin salir de la página.
  // Usa el mismo evento que la ficha de producto del tema, así el contador y el carrito lateral
  // se actualizan solos. Si algo falla, el formulario se envía normal y lleva al carrito.
  if (!window.__mcCartAdd) {
    window.__mcCartAdd = true;
    const setState = (form, state, label, status) => {
      const btn = form.querySelector('.mc-tcard__add');
      const text = form.querySelector('[data-label]');
      if (!form.dataset.label) form.dataset.label = text.textContent;
      if (state) btn.dataset.state = state; else btn.removeAttribute('data-state');
      btn.disabled = state === 'loading';
      text.textContent = label || form.dataset.label;
      form.querySelector('[data-status]').textContent = status || '';
    };
    document.addEventListener('submit', async (e) => {
      const form = e.target instanceof HTMLFormElement && e.target.matches('form[data-mc-add]') ? e.target : null;
      if (!form) return;
      // "Theme" lo declara el tema con const: existe como global, pero no como window.Theme.
      const routes = typeof Theme !== 'undefined' && Theme ? Theme.routes : null;
      if (!routes || !routes.cart_add_url || !window.fetch) return;
      e.preventDefault();
      if (form.dataset.busy) return;
      form.dataset.busy = '1';
      clearTimeout(form.mcTimer);
      setState(form, 'loading', 'Agregando…');

      const id = form.querySelector('[name="id"]').value;
      const sectionIds = Array.from(document.querySelectorAll('cart-items-component'))
        .map((el) => el.dataset.sectionId)
        .filter(Boolean);
      let Ev = null;
      let deferred = null;
      try {
        Ev = (await import('@shopify/events')).CartLinesUpdateEvent;
        deferred = Ev.createPromise();
        form.dispatchEvent(
          new Ev({
            action: 'add',
            context: 'product',
            lines: [{ merchandiseId: String(id), quantity: 1 }],
            promise: deferred.promise,
          })
        );
      } catch (err) {
        deferred = null;
      }

      try {
        const res = await fetch(routes.cart_add_url, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }], sections: sectionIds.join(',') }),
        });
        const data = await res.json();
        if (!res.ok || data.status) throw new Error(data.description || data.message || 'No se pudo agregar');
        const cart = await fetch(`${routes.cart_url}.json`, {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
        }).then((r) => r.json());
        if (deferred) {
          deferred.resolve({
            cart: Ev.createCartFromAjaxResponse(cart),
            detail: { items: cart.items, source: 'mc-card', itemCount: 1, sections: data.sections, didError: false },
          });
          setState(form, 'added', 'Agregado ✓', 'Perfume agregado al carrito');
        } else {
          // Sin los eventos del tema no hay cómo refrescar el carrito lateral: se abre la página del carrito.
          window.location.href = routes.cart_url;
          return;
        }
      } catch (err) {
        if (deferred) deferred.reject(err);
        setState(form, 'error', 'No se pudo agregar', String((err && err.message) || 'No se pudo agregar al carrito'));
      }
      delete form.dataset.busy;
      form.mcTimer = setTimeout(() => setState(form, ''), 2600);
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "MC · Tendencias",
  "tag": "section",
  "class": "mc-trends-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tendencias 2026" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que más está llamando la atención" },
    { "type": "textarea", "id": "intro", "label": "Introducción" },
    { "type": "textarea", "id": "source_note", "label": "Nota de fuentes", "info": "Aclara de dónde sale la tendencia. No la presentes como ventas." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding-block-start", "label": "Arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "tendencia",
      "name": "Tendencia",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre de la tendencia" },
        { "type": "text", "id": "stat", "label": "Dato corto", "info": "Ej.: un dato verificado con su fuente en la nota al pie." },
        { "type": "textarea", "id": "text", "label": "Explicación" },
        { "type": "product_list", "id": "products", "label": "Perfumes", "limit": 6 },
        { "type": "collection", "id": "collection", "label": "Colección para 'Ver toda'" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "MC · Tendencias" }]
}
{% endschema %}
